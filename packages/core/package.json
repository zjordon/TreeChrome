{
  "name": "@tw/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "TreeWalker 核心 TS 库：LLM 多协议客户端（P2）+ browser 层 BrowserSession（P4.2，移植自 tree_walker llm/client.py 与 browser/session.py）。纯 TS：禁 chrome.* / process.*，仅依赖 Web 标准全局（fetch/AbortSignal/performance/atob）。AbortSignal.any 需 Node 20.3+/Chrome 116+",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tw/dom-snapshot": "workspace:*",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@tw/cdp-ws": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.5",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  }
}
