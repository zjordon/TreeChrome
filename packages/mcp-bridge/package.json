{
  "name": "@tw/mcp-bridge",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "tc-bridge 本地 MCP 桥（issue #31 M1）：仅回环 HTTP——/mcp 供编码 agent（MCP Streamable HTTP），/v1/tc/* 私线供扩展 SW 长轮询。独立 bin tc-bridge（serve/connect/status）",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "tc-bridge": "./bin/tc-bridge.mjs"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tw/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  }
}
