node_modules/
dist/
coverage/
*.tsbuildinfo
.idea/
# 编辑器个人配置不共享；如需共享 extensions.json 再改用取反规则
.vscode/
.DS_Store
Thumbs.db
# 敏感配置：密钥/环境变量不入库（提交门兜底，.gitignore 是第一道防线）
.env
.env.*
!.env.example
.envrc
# golden fixtures 是测试资产，需入库；仅忽略抓取过程中的临时目录（任意层级）
_tmp/
# 离线回归 harness 的运行产物（task_skill_match_regression 等）
out/
# rerun/评测运行时产物（read_grid 网格 JSON、run journal 截图）
evaluate_output/
rerun-history/
# WXT（apps/extension）生成物：.wxt 类型/临时、.output 构建产物
.wxt/
.output/
