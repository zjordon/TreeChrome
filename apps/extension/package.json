{
  "name": "extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TreeChrome 扩展宿主（WXT：SW 壳 + sidepanel + options + run journal；架构 §2 apps/extension）",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "e2e:smoke": "node e2e/smoke-cdp-chrome.mjs",
    "e2e:probe": "node e2e/probe-debugger.mjs && node e2e/probe-debugger2.mjs",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e:runtime": "node e2e/smoke-sw-runtime.mjs",
    "e2e:ui": "node e2e/smoke-ui.mjs"
  },
  "dependencies": {
    "@tw/cdp-chrome": "workspace:*",
    "@tw/console-ui": "workspace:*",
    "@tw/core": "workspace:*",
    "@tw/protocol": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "wxt": "^0.21.0",
    "vitest": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7"
  }
}
