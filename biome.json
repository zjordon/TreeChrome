{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.mjs",
      "**/*.json",
      "!**/test/fixtures",
      "!docs",
      "!domain-skills"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/dom-snapshot/src/**",
        "packages/core/src/**",
        "packages/cdp-ws/src/**",
        "packages/console-ui/src/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "chrome": "chrome.* 只能出现在 cdp-chrome 适配包与扩展宿主（架构铁律：平台中立包）",
                  "node:process": "平台中立包禁 ambient env：配置必须显式传入（架构铁律）",
                  "process": "平台中立包禁 ambient env：配置必须显式传入（架构铁律）"
                }
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "process": "平台中立包禁 process 全局（含 process.env）：配置必须显式传入（架构铁律）"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/test/**", "**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
